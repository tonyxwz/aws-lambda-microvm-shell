{
  "name": "pi-lambda-microvm",
  "version": "0.1.0",
  "description": "pi extension: replace the agent's local shell and file tools with an isolated AWS Lambda MicroVM",
  "keywords": ["pi-package", "pi-extension", "aws", "lambda", "microvm", "firecracker", "sandbox"],
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/tonyxwz/aws-lambda-microvm-shell.git" },
  "homepage": "https://github.com/tonyxwz/aws-lambda-microvm-shell#readme",
  "files": ["extension/*.ts", "image/", "README.md"],
  "pi": {
    "extensions": ["./extension/index.ts"]
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1175.0",
    "@aws-sdk/client-iam": "^3.1175.0",
    "@aws-sdk/client-lambda-microvms": "^3.1175.0",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/client-sts": "^3.1175.0"
  },
  "peerDependencies": {
