{
  "name": "pi-lambda-microvm",
  "version": "0.1.2",
  "description": "pi extension: replace the agent's local shell and file tools with an isolated AWS Lambda MicroVM",
  "keywords": [
    "pi-package",
    "pi-extension",
    "aws",
    "lambda",
    "microvm",
    "firecracker",
    "sandbox"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonyxwz/pi-lambda-microvm.git"
  },
  "homepage": "https://github.com/tonyxwz/pi-lambda-microvm#readme",
  "files": [
    "extension/*.ts",
    "image/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1175.0",
    "@aws-sdk/client-iam": "^3.1175.0",
    "@aws-sdk/client-lambda-microvms": "^3.1175.0",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/client-sts": "^3.1175.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
